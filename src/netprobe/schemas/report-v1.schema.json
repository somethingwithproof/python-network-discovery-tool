{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/somethingwithproof/python-network-discovery-tool/schemas/report-v1.schema.json",
  "title": "netprobe scan report, version 1",
  "description": "Written by `scan -o FILE.json` and `scan --format json`. Lists every scanned device.",
  "allOf": [
    {
      "$ref": "common-v1.schema.json#/$defs/scanDocument"
    }
  ],
  "properties": {
    "format": {
      "const": "netprobe-report"
    },
    "version": {
      "const": 1
    }
  }
}
